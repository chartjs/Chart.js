{
    "name": "chart.js",
    "homepage": "https://www.chartjs.org",
    "description": "Simple HTML5 charts using the canvas element.",
    "version": "4.6.2",
    "license": "MIT",
    "type": "module",
    "sideEffects": [
        "./auto/auto.js",
        "./auto/auto.cjs",
        "./dist/chart.umd.min.js",
        "./dist/chart.umd.js"
    ],
    "jsdelivr": "./dist/chart.umd.min.js",
    "unpkg": "./dist/chart.umd.min.js",
    "main": "./dist/chart.cjs",
    "module": "./dist/chart.js",
    "exports": {
        ".": {
            "types": "./dist/types.d.ts",
            "import": "./dist/chart.js",
            "require": "./dist/chart.cjs"
        },
        "./auto": {
            "types": "./auto/auto.d.ts",
            "import": "./auto/auto.js",
            "require": "./auto/auto.cjs"
        },
        "./helpers": {
            "types": "./helpers/helpers.d.ts",
            "import": "./helpers/helpers.js",
            "require": "./helpers/helpers.cjs"
        }
    },
    "types": "./dist/types.d.ts",
    "keywords": [
        "canvas",
        "charts",
        "data",
        "graphs",
        "html5",
        "responsive"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/chartjs/Chart.js.git"
    },
    "bugs": {
        "url": "https://github.com/chartjs/Chart.js/issues"
    },
    "files": [
        "auto/**",
        "dist/**",
        "!dist/docs/**",
        "helpers/**"
    ],
    "scripts": {
        "api-report": "concurrently -P -m 1 -n chart.js,helpers \"api-extractor run {@}\" \"api-extractor run -c api-extractor.helpers.json {@}\" --",
        "autobuild": "rollup -c -w",
        "copyDeclarations": "node -e \"fs.cpSync('./src/types/', './dist/types/', {recursive:true})\"",
        "emitDeclarations": "tsc --emitDeclarationOnly && pnpm copyDeclarations",
        "build": "rollup -c && pnpm emitDeclarations",
        "dev": "vitest --project chromium",
        "dev:ff": "vitest --project firefox",
        "docs": "pnpm run build && cross-env NODE_OPTIONS=--openssl-legacy-provider pnpm --filter \"./docs/**\" build",
        "docs:dev": "pnpm run build && cross-env NODE_OPTIONS=--openssl-legacy-provider pnpm --filter \"./docs/**\" dev",
        "docs:typecheck": "pnpm --filter chartjs-docs-vitepress typecheck",
        "docs:vitepress": "pnpm run build && pnpm --filter chartjs-docs-vitepress site:build",
        "docs:vitepress:dev": "pnpm run build && pnpm --filter chartjs-docs-vitepress site:dev",
        "fixtures:update": "cross-env UPDATE_FIXTURES=1 vitest run --browser.headless test/specs/fixtures.spec.js",
        "lint-js": "eslint \"src/**/*.{js,ts}\" \"test/**/*.js\" \"docs/**/*.js\" --cache",
        "lint-md": "eslint \"**/*.md\" --cache",
        "lint-ts-flags": "node scripts/check-ts-flags.js",
        "lint-types": "pnpm build && pnpm api-report && node test/types/autogen.js && tsc -p test/types",
        "lint": "concurrently \"pnpm:lint-*\"",
        "test": "pnpm lint && pnpm test-ci",
        "test-ci": "concurrently \"pnpm:test-ci-*\"",
        "test-ci-vitest": "vitest run --coverage --browser.headless",
        "test-ci-umd": "vitest run --config vitest.umd.config.js --browser.headless",
        "test-ci-integration": "pnpm --filter \"./test/integration/**\" test"
    },
    "dependencies": {
        "@kurkle/color": "^0.6.6"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.60.1",
        "@rollup/plugin-inject": "^5.0.5",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.2",
        "@swc/core": "^1.16.22",
        "@types/estree": "^1.0.0",
        "@types/offscreencanvas": "^2019.7.0",
        "@typescript-eslint/eslint-plugin": "^5.32.0",
        "@typescript-eslint/parser": "^5.32.0",
        "@vitest/browser": "^5.1.1",
        "@vitest/browser-playwright": "^5.1.1",
        "@vitest/coverage-istanbul": "^5.1.1",
        "chartjs-adapter-luxon": "^1.2.0",
        "chartjs-adapter-moment": "^1.0.0",
        "chartjs-test-utils": "^1.1.2",
        "concurrently": "^7.3.0",
        "cross-env": "^7.0.3",
        "eslint": "^8.21.0",
        "eslint-config-chartjs": "^0.3.0",
        "eslint-plugin-es": "^4.1.0",
        "eslint-plugin-html": "^7.1.0",
        "eslint-plugin-markdown": "^3.0.0",
        "esm": "^3.2.25",
        "glob": "^8.0.3",
        "luxon": "^3.0.1",
        "moment": "^2.29.4",
        "moment-timezone": "^0.5.34",
        "playwright": "^1.65.1",
        "rollup": "^4.68.4",
        "rollup-plugin-cleanup": "^3.2.1",
        "rollup-plugin-swc3": "^0.12.1",
        "typescript": "^4.7.4",
        "vitest": "^5.1.1"
    },
    "engines": {
        "pnpm": ">=12"
    },
    "packageManager": "pnpm@12.21.0"
}
